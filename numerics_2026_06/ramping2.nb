     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", "#2"}], "}"}], ",", 
          RowBox[{
           RowBox[{"ColorData", "[", 
            RowBox[{"{", 
