 "argument:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"Abs", "[", 
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{"1", "|", 
        FractionBox["dH", "dB"], "|", "0"}], "\[RightAngleBracket]"}], "]"}], 
     
