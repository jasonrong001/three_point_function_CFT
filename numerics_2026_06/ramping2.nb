Cell[BoxData[{
 RowBox[{
  RowBox[{"temp", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", 
       RowBox[{"#", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "&"}], "/@", "temp0"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Sort", "[", 
    RowBox[{"temp", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "<", 
       RowBox[{"#2", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"data", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "<", "0.5"}], "&"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "2.", " ", "Extract", " ", "the", " ", "minimum", " ", "and", " ", 
     "maximum", " ", "z"}], "-", 
    RowBox[{
    "values", " ", "to", " ", "scale", " ", "the", " ", "color", " ", 
     "function"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"zMin", ",", "zMax"}], "}"}], "=", 
    RowBox[{"MinMax", "[", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}], 
   RowBox[{"(*", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Min", "[", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}], ",", "0.5"}], "}"}], 
    "*)"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Define", " ", "your", " ", "preferred", " ", "color", " ", 
    "scheme"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"colorScheme", "=", "\"\<TemperatureMap\>\""}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Other", " ", "good", " ", 
     RowBox[{"options", ":", "\"\<TemperatureMap\>\""}]}], ",", 
    "\"\<Viridis\>\""}], "*)"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "4.", " ", "Create", " ", "the", " ", "plot", " ", "with", " ", "a", " ", 
    "legend"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Legended", "[", 
   RowBox[{
    RowBox[{"ListPlot", "[", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Apply", " ", "Style", " ", "to", " ", "each", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], " ", "coordinate", " ", "using", " ",
         "the", " ", "z"}], "-", 
